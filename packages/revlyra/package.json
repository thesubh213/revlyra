{
  "name": "revlyra",
  "version": "0.1.0",
  "description": "Self-hosted review integrity engine: SDK, CLI, HTTP server, database adapters, media and campaign detection.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "revlyra": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.2.1",
    "@revlyra/core": "workspace:*",
    "commander": "^15.0.0",
    "csv-parse": "^6.0.0",
    "exifr": "^7.1.3",
    "fastify": "^5.0.0",
    "picocolors": "^1.1.0",
    "stream-json": "^1.9.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@revlyra/transformer": "workspace:*",
    "mongodb": ">=6",
    "mysql2": ">=3",
    "pg": ">=8",
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "@revlyra/transformer": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.0.0",
    "mongodb": "^6.0.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "sharp": "^0.34.0"
  },
  "keywords": [
    "reviews",
    "fake-reviews",
    "fraud-detection",
    "trust-and-safety",
    "moderation"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
