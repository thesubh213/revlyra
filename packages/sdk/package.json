{
  "name": "@revlyra/sdk",
  "version": "0.1.0",
  "description": "Isomorphic HTTP client for the Revlyra review integrity API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@revlyra/core": "workspace:*"
  },
  "keywords": [
    "revlyra",
    "reviews",
    "sdk",
    "client"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
