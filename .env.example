# Copy to .env.local and replace every value. Never commit real secrets.

# Dev license generated by `revlyra init` / `revlyra keygen`.
REVLYRA_LICENSE_KEY=

# Optional online license lease / revocation endpoint.
# REVLYRA_LICENSE_SERVER=https://license.example.com

# HMAC pepper for reviewer/item identifiers. Generate 32 random bytes.
REVLYRA_PII_PEPPER=

# Admin API bootstrap key.
REVLYRA_ADMIN_KEY=

# First tenant API key (server clients).
REVLYRA_API_KEY=

# Store
REVLYRA_DB_DRIVER=sqlite
REVLYRA_DB_PATH=./data/revlyra.db
# REVLYRA_DATABASE_URL=postgres://user:pass@localhost:5432/revlyra

# Server
REVLYRA_HOST=127.0.0.1
REVLYRA_PORT=8787
REVLYRA_WORKER=inline
REVLYRA_LOG_LEVEL=info
REVLYRA_TELEMETRY=false

# Optional outbound webhooks (HTTPS only)
# REVLYRA_WEBHOOK_URL=https://example.com/hooks/revlyra
# REVLYRA_WEBHOOK_SECRET=

# Detection
REVLYRA_POLICY=balanced
REVLYRA_MEDIA_ENABLED=false
REVLYRA_TRANSFORMER=false
REVLYRA_MODEL_DIR=
REVLYRA_MODEL_OFFLINE=0
# Explicit consent is required before downloading models from Hugging Face.
REVLYRA_MODEL_DOWNLOAD=0
# REVLYRA_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# REVLYRA_CLASSIFIER_MODEL=your-org/deberta-fake-review
REVLYRA_RETENTION_DAYS=180

# Governance (DSA/DMCCA artifacts). Appeal SLA days = response promise for the
# internal complaints system; territory set the statement-of-reasons locality.
REVLYRA_APPEAL_SLA_DAYS=30
# REVLYRA_SOR_TERRITORY=global   # EU | UK | US | global
# REVLYRA_OOCD_BODY=Certified out-of-court dispute settlement body name
# Strip identity-like keys (real names, resumes, profile URLs) from caller
# metadata before persistence (pseudonymous reviewer protection). 0 = off.
REVLYRA_IDENTITY_MINIMIZATION=1

# Optional source credentials (referenced by name in source configs)
# REVLYRA_SOURCE_PG_URL=postgres://readonly:secret@localhost:5432/reviews
# REVLYRA_SOURCE_MYSQL_URL=mysql://readonly:secret@localhost:3306/reviews
# REVLYRA_SOURCE_MONGO_URL=mongodb://readonly:secret@localhost:27017/reviews
